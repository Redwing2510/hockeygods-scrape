# --- Reddit (read-only, app-only OAuth) ---
# Create a free "script" app at https://www.reddit.com/prefs/apps (see README).
# No Reddit username/password needed for this grant type.
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_USER_AGENT=hockeygods-scrape-bot/0.1 by <your-reddit-username>

# --- Drafting model ---
# console.anthropic.com -> API keys.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5

# --- Email delivery ---
# A Gmail *app password* (myaccount.google.com/apppasswords), not your real
# password — needs 2-Step Verification turned on first. Any SMTP account works;
# this is just the path with the fewest moving parts.
GMAIL_USER=
GMAIL_APP_PASSWORD=
DIGEST_TO=
