# --- Reddit ---
# No signup, no API key — pulls from Reddit's public RSS feeds, which are
# rate-limited to ~1 request/minute/IP but need no registration at all. This
# is just a courtesy identifier in the request header, not a real credential.
REDDIT_USER_AGENT=hockeygods-scrape/0.1 by <your-reddit-username-or-contact>

# --- Drafting model ---
# console.anthropic.com -> API keys.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5

# --- Email delivery ---
# A Gmail *app password* (myaccount.google.com/apppasswords), not your real
# password — needs 2-Step Verification turned on first. Any SMTP account works;
# this is just the path with the fewest moving parts.
GMAIL_USER=
GMAIL_APP_PASSWORD=
DIGEST_TO=
