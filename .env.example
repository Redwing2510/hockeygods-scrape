# --- Reddit data ---
# Primary path: a paid key from redditapis.com (an independent third party,
# not Reddit) — sign up at redditapis.com/signup (Google or email, $0.50 free
# credit, no card needed), grab the bearer token from your dashboard. Fast, no
# per-minute pacing, and it's the only path with real comment threads.
REDDITAPIS_TOKEN=

# Fallback: if REDDITAPIS_TOKEN is unset, the script uses Reddit's own public
# RSS feeds instead — no signup, but rate-limited to ~1 request/minute/IP and
# no comments available. REDDIT_USER_AGENT is just a courtesy identifier for
# that path, not a real credential.
REDDIT_USER_AGENT=hockeygods-scrape/0.1 by <your-reddit-username-or-contact>

# --- Drafting model ---
# console.anthropic.com -> API keys.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5

# --- Email delivery ---
# A Gmail *app password* (myaccount.google.com/apppasswords), not your real
# password — needs 2-Step Verification turned on first. Any SMTP account works;
# this is just the path with the fewest moving parts.
GMAIL_USER=
GMAIL_APP_PASSWORD=
DIGEST_TO=
