<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.hockeygods.scrape-digest</string>

  <!-- Runs via a login shell so it picks up PATH (node, npm) the same way a
       terminal would, rather than launchd's minimal default PATH. -->
  <key>ProgramArguments</key>
  <array>
    <string>/bin/zsh</string>
    <string>-l</string>
    <string>-c</string>
    <string>cd /Users/nicklamanna/Documents/hockeygods-scrape &amp;&amp; npm run digest</string>
  </array>

  <!-- launchd's calendar interval is wall-clock time in the Mac's own system
       timezone, not a fixed UTC offset. This machine's system timezone is
       already America/New_York (confirmed via `date` -> EDT), so 12:00 here
       really is 12:00 Eastern, and macOS's own DST handling keeps it there
       year-round without any change needed at the fall/spring transitions.
       If this ever runs on a machine set to a different timezone, these
       numbers need to be that zone's local-time equivalent of noon Eastern. -->
  <key>StartCalendarInterval</key>
  <dict>
    <key>Hour</key>
    <integer>12</integer>
    <key>Minute</key>
    <integer>0</integer>
  </dict>

  <key>StandardOutPath</key>
  <string>/Users/nicklamanna/Documents/hockeygods-scrape/digest.log</string>
  <key>StandardErrorPath</key>
  <string>/Users/nicklamanna/Documents/hockeygods-scrape/digest.err</string>

  <key>RunAtLoad</key>
  <false/>
</dict>
</plist>
